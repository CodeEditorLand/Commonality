	"description": "The Next.js application that powers Commonality Studio",
	"repository": {
		"type": "git",
		"url": "https://github.com/commonalityco/commonality",
		"directory": "apps/studio"
	},
	"main": "./start.mjs",
	"files": [
		".next/",
		"start.mjs",
		"next.config.js",
		"server.js",
		"dist/"
	],
	"scripts": {
		"analyze": "ANALYZE=true next build",
		"build": "next build && pnpm run clean-cache",
		"clean-cache": "rimraf .next/cache",
		"dev": "COMMONALITY_ROOT_DIRECTORY='../../' NODE_ENV=development node server.js",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"start": "NODE_ENV=production node server.js",
		"test": "vitest",
		"type-check": "tsc --noEmit"
	},
