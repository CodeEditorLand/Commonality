    "@typescript-eslint/parser": "^8.22.0",
    "@vitest/coverage-v8": "^3.0.4",
    "commonality": "workspace:*",
    "commonality-checks-recommended": "workspace:*",
    "eslint": "^9.19.0",
    "eslint-config-commonality": "workspace:*",
    "eslint-plugin-unused-imports": "^4.1.4",
    "execa": "^9.5.2",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
