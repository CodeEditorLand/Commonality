{
	"name": "@commonalityco/ui-package",
	"version": "0.2.37",
	"description": "Presentational components to build the Commonality package view",
	"repository": {
		"type": "git",
		"url": "https://github.com/commonalityco/commonality",
		"directory": "packages/ui-package"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./*": "./src/*.ts"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"build": "tsc --build",
		"dev": "tsc --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest",
		"type-check": "tsc --noEmit"
	},
	"devDependencies": {
		"@commonalityco/config-tailwind": "workspace:*",
		"@commonalityco/config-tsconfig": "workspace:*",
		"@commonalityco/ui-design-system": "workspace:*",
		"@commonalityco/utils-core": "workspace:*",
		"@tanstack/react-table": "8.10.1",
		"@testing-library/jest-dom": "6.6.3",
		"@testing-library/react": "16.3.0",
		"@testing-library/user-event": "14.6.1",
		"@types/react": "19.1.0",
		"@vitejs/plugin-react-swc": "3.8.1",
		"eslint-config-commonality": "workspace:*",
		"lucide-react": "0.487.0",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"tailwindcss": "3.4.17",
		"typescript": "5.8.2"
	},
	"peerDependencies": {
		"@tanstack/react-table": "8.x"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.js"
		},
		"main": "./dist/index.js",
		"module": "./dist/index.js",
		"types": "./dist/index.d.ts"
	}
}
