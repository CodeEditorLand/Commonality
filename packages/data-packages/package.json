{
	"name": "@commonalityco/data-packages",
	"version": "0.2.40",
	"description": "Get package information about a local project",
	"repository": {
		"type": "git",
		"url": "https://github.com/commonalityco/commonality",
		"directory": "packages/data-packages"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"build": "tsc --build",
		"dev": "tsc --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@commonalityco/data-project": "workspace:*",
		"@commonalityco/utils-core": "workspace:*",
		"fs-extra": "11.3.0"
	},
	"devDependencies": {
		"@commonalityco/config-tsconfig": "workspace:*",
		"@commonalityco/types": "workspace:*",
		"@types/fs-extra": "11.0.4",
		"@types/node": "22.15.3",
		"eslint-config-commonality": "workspace:*",
		"typescript": "5.8.3"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.js"
		},
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts"
	}
}
