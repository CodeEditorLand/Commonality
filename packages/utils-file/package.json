{
	"name": "@commonalityco/utils-file",
	"version": "0.0.3",
	"description": "Utilities to read and write to the local file system",
	"repository": {
		"type": "git",
		"url": "https://github.com/commonalityco/commonality",
		"directory": "packages/utils-file"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./json": "./dist/json.js",
		"./text": "./dist/text.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc --build",
		"dev": "tsc --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"chalk": "5.4.1",
		"detect-indent": "7.0.1",
		"fs-extra": "11.3.0",
		"jest-diff": "30.0.2",
		"lodash-es": "4.17.21",
		"mock-fs": "5.5.0",
		"pathe": "2.0.3",
		"strip-ansi": "7.1.0"
	},
	"devDependencies": {
		"@commonalityco/config-tsconfig": "0.0.1",
		"@commonalityco/types": "0.2.40",
		"@commonalityco/utils-core": "0.0.1",
		"@types/fs-extra": "11.0.4",
		"@types/lodash-es": "4.17.12",
		"@types/mock-fs": "4.13.4",
		"eslint-config-commonality": "0.0.13",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"typescript": "5.8.3"
	},
	"peerDependencies": {
		"@commonalityco/utils-core": "*",
		"react": ">=19",
		"react-dom": ">=19"
	},
	"publishConfig": {
		"access": "public"
	}
}
