{
	"name": "@commonalityco/utils-package",
	"version": "0.2.37",
	"description": "Utilities for formatting package data",
	"repository": {
		"type": "git",
		"url": "https://github.com/commonalityco/commonality",
		"directory": "packages/utils-package"
	},
	"license": "MIT",
