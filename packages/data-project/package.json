{
	"name": "@commonalityco/data-project",
	"version": "0.2.40",
	"description": "Utilities for collecting metadata on the current Commonality project",
	"repository": {
		"type": "git",
		"url": "https://github.com/commonalityco/commonality",
		"directory": "packages/data-project"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./*": "./dist/*.js"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"build": "tsc --build",
		"dev": "tsc --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@commonalityco/utils-core": "workspace:*",
		"find-up": "7.0.0",
		"fs-extra": "11.3.0",
		"globby": "14.1.0",
		"jiti": "2.4.2",
		"yaml": "2.7.0",
		"zod": "3.24.2"
	},
	"devDependencies": {
		"@commonalityco/config-tsconfig": "workspace:*",
		"@commonalityco/types": "workspace:*",
		"@types/fs-extra": "11.0.4",
		"@types/mock-fs": "4.13.4",
		"@types/node": "22.13.9",
		"eslint-config-commonality": "workspace:*",
		"mock-fs": "5.5.0",
		"typescript": "5.8.2"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.js"
		},
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts"
	}
}
